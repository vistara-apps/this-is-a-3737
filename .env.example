# KnowYourRights AI - Environment Variables

# OpenAI API Configuration
VITE_OPENAI_API_KEY=your-openai-api-key-here
VITE_OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Pinata IPFS Configuration
VITE_PINATA_API_KEY=your-pinata-api-key-here
VITE_PINATA_SECRET_KEY=your-pinata-secret-key-here
VITE_PINATA_JWT=your-pinata-jwt-token-here

# Airstack API Configuration
VITE_AIRSTACK_API_KEY=your-airstack-api-key-here

# Stripe Configuration
VITE_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key-here
STRIPE_SECRET_KEY=your-stripe-secret-key-here

# Application Configuration
VITE_APP_NAME=KnowYourRights AI
VITE_APP_VERSION=1.0.0
VITE_APP_ENVIRONMENT=development

# Feature Flags
VITE_ENABLE_PREMIUM_FEATURES=true
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_ERROR_REPORTING=true

# Emergency Services Configuration
VITE_EMERGENCY_WEBHOOK_URL=your-emergency-webhook-url-here
VITE_ENABLE_REAL_ALERTS=false
